#!/usr/bin/env bash
# Prepares a fresh orb with the legacy (default) Python runtime and the Rust toolchain.
# Model weights (weights/*.pt, ckpt.t7) are private and not downloaded here.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
venv="$HOME/.venvs/traffic-legacy"
log() { printf '[setup %s] %s\n' "$(date +%H:%M:%S)" "$*"; }

# System libraries for OpenCV and PyQt5 (checked first so warm runs skip apt-get).
apt_packages=(libgl1 libglib2.0-0 libxkbcommon0 libegl1 libdbus-1-3 libfontconfig1 libsm6 libxext6 libxrender1)
missing=()
for package in "${apt_packages[@]}"; do
  dpkg -s "$package" >/dev/null 2>&1 || missing+=("$package")
done
if ((${#missing[@]})); then
  log "apt install: ${missing[*]}"
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}"
fi

# Python 3.12 venv (the project requires 3.12). Orbs have no GPU, so torch comes from the CPU index.
export PATH="$HOME/.local/bin:$PATH"
log "uv python install 3.12"
uv python install 3.12
if [[ ! -x "$venv/bin/python" ]]; then
  log "creating $venv"
  uv venv --python 3.12 "$venv"
fi
export VIRTUAL_ENV="$venv"
log "installing torch CPU wheels"
uv pip install --python "$venv/bin/python" --torch-backend=cpu torch==2.13.0 torchvision==0.28.0
log "installing requirements/legacy.txt"
uv pip install --python "$venv/bin/python" -r "$repo_root/requirements/legacy.txt"
uv pip check --python "$venv/bin/python"

# Modern profile (Ultralytics 8.4, NumPy 2) for test_environment_setup; separate venv because it conflicts with legacy.
modern_venv="$HOME/.venvs/traffic-modern"
if [[ ! -x "$modern_venv/bin/python" ]]; then
  log "creating $modern_venv"
  uv venv --python 3.12 "$modern_venv"
fi
log "installing requirements/modern.txt"
uv pip install --python "$modern_venv/bin/python" --torch-backend=cpu torch==2.13.0 torchvision==0.28.0 -r "$repo_root/requirements/modern.txt"
uv pip install --python "$modern_venv/bin/python" pip==25.0.1
uv pip check --python "$modern_venv/bin/python"

# Rust toolchain for rust-ui (edition 2024 needs 1.88+), then fetch crates into the cache.
if [[ ! -x "$HOME/.cargo/bin/cargo" ]]; then
  log "installing rustup stable"
  curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
fi
export PATH="$HOME/.cargo/bin:$PATH"
log "cargo fetch rust-ui"
cargo fetch --locked --manifest-path "$repo_root/rust-ui/Cargo.toml"

# Activate the venv and Rust in login shells, once.
profile_marker="# traffic-pedestrian orb toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  log "adding toolchain activation to ~/.bash_profile"
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
[ -f "$venv/bin/activate" ] && . "$venv/bin/activate"
[ -d "\$HOME/.cargo/bin" ] && export PATH="\$HOME/.cargo/bin:\$PATH"
EOF
fi
log "setup complete"
