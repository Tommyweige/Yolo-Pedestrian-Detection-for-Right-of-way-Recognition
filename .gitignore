weights/*.pt
weights/*.pth
weights/*.t7
weights/*.onnx
weights/*.engine

# Python bytecode.
__pycache__/
*.py[cod]

# Runtime previews and temporary files.
runtime/
rust-ui/target/

# Datasets, private media and secrets.
datasets/
.env
*.key

# Ultralytics training/validation outputs.
runs/
