# Local model assets are required at runtime but should not be committed.
weights/*.pt
weights/*.pth
weights/*.t7
weights/*.onnx
weights/*.engine

# Python bytecode.
__pycache__/
*.py[cod]

# Runtime previews and temporary files.
runtime/
rust-ui/target/

# Datasets, private media and secrets.
datasets/
.env
*.key

# Ultralytics training/validation outputs.
runs/

# Per-video human event labels (contain video file names).
labels/

# Amp orb portal registrations.
.amp/portals/

# Root-level local dataset copies, run outputs, and downloaded weights.
/data/
/out/
*.pt
